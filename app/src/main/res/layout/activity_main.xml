<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pixel Steganography"
            android:textColor="#E94560"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hide files inside images"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSelectImage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Select Image"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#16213E"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSelectFile"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Select File"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#16213E"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Password (optional, for encryption)"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16213E"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnHide"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Hide Data"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#0F3460"
                android:layout_marginEnd="4dp"
                android:enabled="false" />

            <Button
                android:id="@+id/btnExtract"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Extract Data"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#0F3460"
                android:layout_marginStart="4dp"
                android:enabled="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveOutput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Save Output to Downloads"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#E94560"
            android:layout_marginBottom="12dp"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="#E94560"
            android:layout_gravity="center_horizontal" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerInside"
            android:background="#0F3460"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select an image to begin..."
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#0F3460"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="About"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#E94560" />

    </LinearLayout>
</ScrollView>
